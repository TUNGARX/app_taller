[Unit]
Description=Automotivo taller-app (Next.js)
After=network.target

[Service]
Type=simple
User=taller
Group=taller
WorkingDirectory=/opt/taller-app/app
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
