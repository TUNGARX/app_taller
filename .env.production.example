# Copy to .env.local on the production server (never commit the real values).
# Generate a fresh secret for production — never reuse the one from local dev:
#   openssl rand -base64 32
AUTH_SECRET=

# Lets Auth.js trust the reverse-proxy's forwarded host/proto headers.
AUTH_TRUST_HOST=true

# Required in production even with AUTH_TRUST_HOST=true -- without this,
# some Auth.js redirect responses (e.g. signOut(), used by the forced
# password-change flow) fall back to hardcoded http://localhost:3000
# instead of deriving the host from the request. Set to the real
# production URL (no trailing slash):
AUTH_URL=https://your-domain.example

# --- Google Drive + Calendar integration (evidence photos/videos, citas sync) ---
# See src/lib/google/client.ts. Both are required together -- if either is
# missing, the app disables the feature (photo/video uploads via
# /api/ordenes/[id]/media return 503; Cita creation/cancellation just skips
# the Calendar sync) instead of failing requests.

# The full service-account key JSON, as a single-line string -- NOT a file
# path. Generate this in Google Cloud Console (APIs & Services > Credentials
# > Create Service Account > Keys > Add Key > JSON), then collapse it to one
# line, e.g.: node -e "console.log(JSON.stringify(require('./key.json')))"
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Workspace mailbox the service account impersonates via domain-wide
# delegation (Admin Console > Security > API Controls > Domain-wide
# Delegation, using the service account's Client ID, scopes
# https://www.googleapis.com/auth/drive and
# https://www.googleapis.com/auth/calendar). This is the account that owns
# the "Automotivo" Drive folder and the appointments calendar.
GOOGLE_IMPERSONATE_EMAIL=contacto@fonsfideishop.com
