# Copy to .env.local on the production server (never commit the real values).
# Generate a fresh secret for production — never reuse the one from local dev:
#   openssl rand -base64 32
AUTH_SECRET=

# Lets Auth.js trust the reverse-proxy's forwarded host/proto headers.
AUTH_TRUST_HOST=true

# Required in production even with AUTH_TRUST_HOST=true -- without this,
# some Auth.js redirect responses (e.g. signOut(), used by the forced
# password-change flow) fall back to hardcoded http://localhost:3000
# instead of deriving the host from the request. Set to the real
# production URL (no trailing slash):
AUTH_URL=https://your-domain.example
